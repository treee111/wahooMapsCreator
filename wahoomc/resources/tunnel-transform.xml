<?xml version="1.0"?>
<translations>
  <translation>
    <name>Adjust tunnel Layers</name>
    <description>Adjust tunnel Layers</description>
    <match type="way" mode="or">
      <match mode="and">
        <tag k="highway" v=".*"/>
        <tag k="tunnel" v="yes"/>
      </match>
      <match mode="and">
        <tag k="railway" v=".*"/>
        <tag k="tunnel" v="yes"/>
      </match>
    </match>
    <output>
      <copy-all/>
      <tag k="layer" v="0"/>
    </output>
  </translation>

  <translation>
    <name>Squadrats Name tag</name>
    <match type="way" mode="and">
      <tag k="squadrats" v="complete"/>
      <tag k="name" match_id="_type" v="(\w+['s]*).*"/>
    </match>
    <output>
      <copy-all/>
      <tag k="squadrats_type" from_match="_type" v="{1}"/>
    </output>
  </translation>
</translations>